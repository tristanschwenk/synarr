# Routes for hub.tristanschwenk.fr, imported by caddy/Caddyfile.
# Only tailnet devices reach this Caddy (the DNS record points at the server's Tailscale IP).
# Tests: bin/test-caddy.sh

# Bazarr and Jellystat answer the bare path with an absolute http:// redirect. Port 80 is
# another service and the https hub blocks http frames, so redirect here, relative.
redir /bazarr /bazarr/ 308
redir /jellystat /jellystat/ 308

handle /radarr* {
	reverse_proxy vpn:7878
}

handle /sonarr* {
	reverse_proxy vpn:8989
}

handle /prowlarr* {
	reverse_proxy vpn:9696
}

handle /bazarr* {
	reverse_proxy vpn:6767
}

# RPC authentication is off in Transmission's settings.json.
handle /transmission* {
	reverse_proxy vpn:9091
}

# Jellystat's page loads its bundle from /assets/ at the root, even with JS_BASE_URL.
# The hub (Nuxt) serves its own files under /_nuxt/ and never uses /assets/.
@jellystat path /jellystat* /assets/*
handle @jellystat {
	reverse_proxy jellystat:3000
}

handle {
	reverse_proxy hub:3000
}
