# Copy to .env (gitignored) and fill in real values:
#   cp .env.example .env
# Generate random secrets with: openssl rand -hex 32

# --- VPN (gluetun) ---
OPENVPN_USER=
OPENVPN_PASSWORD=

# --- Jellystat database (shared by postgres and jellystat) ---
POSTGRES_PASSWORD=

# --- Jellystat ---
JELLYSTAT_JWT_SECRET=

# --- Cloudflare Tunnel ---
# Zero Trust > Networks > Tunnels > <tunnel> > token
CLOUDFLARE_TUNNEL_TOKEN=

# --- Cloudflare API token (Caddy's Let's Encrypt DNS challenge for hub.) ---
# My Profile > API Tokens > Create Token > "Edit zone DNS", zone tristanschwenk.fr only
CLOUDFLARE_API_TOKEN=
