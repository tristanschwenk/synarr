# Copy to .env (gitignored) and fill in real values:
#   cp .env.example .env
# Generate random secrets with: openssl rand -hex 32

# --- VPN (gluetun) ---
OPENVPN_USER=
OPENVPN_PASSWORD=

# --- Jellystat database (shared by postgres and jellystat) ---
POSTGRES_PASSWORD=

# --- Jellystat ---
JELLYSTAT_JWT_SECRET=

# --- Hub (must differ from JELLYSTAT_JWT_SECRET) ---
BETTER_AUTH_SECRET=
