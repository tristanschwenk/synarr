# Caddyfile for home.tristanschwenk.fr
#
# Cloudflare Access is the only authentication in front of the hub and the admin tools.
# Only the cloudflared container reaches this Caddy: never publish it on a host port.
# Requests that did not pass Cloudflare Access (no Cf-Access-Jwt-Assertion header) get 403.
# Tests: bin/test-caddy.sh
:80 {
	# Caddy runs `handle` before a bare `respond`, so the check must be its own `handle`.
	@no_access not header Cf-Access-Jwt-Assertion *
	handle @no_access {
		respond 403
	}

	handle /radarr* {
		reverse_proxy vpn:7878
	}

	handle /sonarr* {
		reverse_proxy vpn:8989
	}

	handle /prowlarr* {
		reverse_proxy vpn:9696
	}

	handle /bazarr* {
		reverse_proxy vpn:6767
	}

	# RPC authentication is off in Transmission's settings.json.
	handle /transmission* {
		reverse_proxy vpn:9091
	}

	handle /jellystat* {
		reverse_proxy jellystat:3000
	}

	handle {
		reverse_proxy hub:3000
	}
}
